---
import type { SiteSettings } from '../lib/types';
interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const links = [
  ['O mnie', '/o-nas'],
  ['Ebooki', '/ebooki'],
  ['Pieczywo', '/produkty'],
  ['Blog', '/blog'],
  ['Kontakt', '/kontakt'],
];
---

<a class="skip" href="#main">
  Przejdź do treści
</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Twoja Dietetyczka — strona główna">
      {settings.logo ? (
        <img src={settings.logo} width="160" height="50" alt="Twoja Dietetyczka" />
      ) : (
        <>
          <span>TWOJA DIETETYCZKA</span>
          <small>zdrowe nawyki, bez presji</small>
        </>
      )}
    </a>
    <nav aria-label="Główna" id="main-nav">
      {links.map(([label, href]) => (
        <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="btn btn-dark shop-link" type="button" data-booking-open>
        <span class="shop-label">Umów konsultację</span>
        <span class="shop-short-label">Umów</span>
        <span aria-hidden="true">↗</span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Przełącz menu nawigacji"
        aria-controls="main-nav"
        aria-expanded="false"
      >
        <span class="menu-label">Menu</span> <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid #d9d3cc80;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 100px;
  }
  .brand {
    display: grid;
    text-align: center;
    flex-shrink: 0;
  }
  .brand span {
    font-family: var(--font-serif);
    font-size: 24px;
    letter-spacing: 0.01em;
  }
  .brand small {
    font-size: 8px;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  nav {
    display: flex;
    gap: 28px;
    font-size: 12px;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--color-action);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .shop-link {
    white-space: nowrap;
  }
  .shop-short-label {
    display: none;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    font-size: 12px;
  }
  @media (max-width: 1023px) {
    nav {
      gap: 16px;
    }
  }
  @media (max-width: 767px) {
    .header-inner {
      min-height: 82px;
      gap: 4px;
    }
    .brand span {
      font-size: 16px;
    }
    .brand small {
      font-size: 6px;
    }
    .header-actions {
      gap: 4px;
    }
    .shop-link {
      padding: 8px 10px;
      gap: 6px;
      font-size: 10px;
    }
    .shop-label,
    .menu-label {
      display: none;
    }
    .shop-short-label {
      display: inline;
    }
    .menu-toggle {
      display: block;
      padding: 8px;
    }
    nav {
      display: none;
      position: absolute;
      top: 82px;
      left: 0;
      right: 0;
      background: var(--color-paper);
      padding: 24px;
      box-shadow: 0 12px 20px #0000000a;
    }
    nav[data-open] {
      display: flex;
      flex-direction: column;
    }
    nav a {
      padding: 9px;
      font-size: 16px;
    }
  }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector('#main-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggle?.setAttribute('aria-expanded', 'false');
      nav?.removeAttribute('data-open');
    }
  });
</script>
