---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import { products } from '../lib/catalog';
interface Props {
  title: string;
  type?: 'digital' | 'physical';
}
const { title, type } = Astro.props;
let catalog = (await products()).filter((p) => !type || p.productType === type);
const query = Astro.url.searchParams.get('q') || '';
if (query)
  catalog = catalog.filter((p) =>
    p.name.toLocaleLowerCase('pl').includes(query.toLocaleLowerCase('pl')),
  );
if (Astro.url.searchParams.has('wyroznione')) catalog = catalog.filter((p) => p.featured);
const sort = Astro.url.searchParams.get('sort') || 'featured';
if (sort === 'price-asc') catalog.sort((a, b) => a.price - b.price);
if (sort === 'price-desc') catalog.sort((a, b) => b.price - a.price);
---

<Layout title={title}>
  <section class="container section">
    <p class="eyebrow">Zdrowe inspiracje</p>
    <h1>{title}</h1>
    <p class="intro muted">Ebooki i pieczywo w wersji, która wspiera zdrowy rytm codzienności.</p>
    <div class="catalog-bar mb-6">
      <nav aria-label="Kategorie" class="flex flex-wrap gap-6">
        <a href="/sklep" aria-current={!type ? 'page' : undefined}>
          Wszystko
        </a>
        <a href="/ebooki" aria-current={type === 'digital' ? 'page' : undefined}>
          Ebooki
        </a>
        <a href="/produkty" aria-current={type === 'physical' ? 'page' : undefined}>
          Pieczywo
        </a>
      </nav>
      <form class="flex flex-wrap gap-3">
        <label>
          <span class="sr-only">Szukaj ebooka lub pieczywa</span>
          <input name="q" value={query} placeholder="Szukaj ebooka lub pieczywa" />
        </label>
        <label>
          <span class="sr-only">Sortowanie</span>
          <select name="sort">
            <option value="featured" selected={sort === 'featured'}>
              Polecane
            </option>
            <option value="price-asc" selected={sort === 'price-asc'}>
              Cena rosnąco
            </option>
            <option value="price-desc" selected={sort === 'price-desc'}>
              Cena malejąco
            </option>
          </select>
        </label>
        <button class="btn btn-outline" type="submit">
          Pokaż
        </button>
      </form>
    </div>

    <div class="catalog-grid">
      {catalog.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
    {catalog.length === 0 && (
      <p class="notice">
        Nie znaleźliśmy ebooków ani pieczywa. Zmień wyszukiwanie lub wróć do wszystkich pozycji.
      </p>
    )}
  </section>
</Layout>
<style>
  .catalog-bar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    margin: 48px 0 24px;
    padding-block: 24px;
    border-block: 1px solid var(--color-border);
    font-size: 13px;
  }
  .catalog-bar [aria-current] {
    border-bottom: 1px solid var(--color-action);
    color: var(--color-action);
  }
  .catalog-bar input,
  .catalog-bar select {
    font-size: 12px;
    max-width: 210px;
  }
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px 30px;
  }
  @media (max-width: 1023px) {
    .catalog-bar {
      flex-direction: column;
      align-items: start;
    }
    .catalog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
    .catalog-bar input {
      max-width: 100%;
    }
  }
</style>
