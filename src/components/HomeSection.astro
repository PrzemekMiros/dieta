<script>
  document.querySelectorAll<HTMLButtonElement>('[data-photo-carousel]').forEach((button) =>
    button.addEventListener('click', () => {
      const track = document.querySelector<HTMLElement>('.photo-carousel');
      track?.scrollBy({
        left: track.clientWidth * Number(button.dataset.photoCarousel),
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    }),
  );
  document
    .querySelector<HTMLFormElement>('#newsletter-form')
    ?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const message = form.querySelector<HTMLElement>('[data-form-message]')!;
      const button = form.querySelector('button')!;
      button.disabled = true;
      try {
        const data = new FormData(form);
        const response = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            consent: data.get('consent') === 'on',
          }),
        });
        const result = await response.json();
        message.textContent = result.message || result.error;
        if (response.ok) form.reset();
      } catch {
        message.textContent = 'Nie udało się połączyć. Spróbuj ponownie.';
      } finally {
        button.disabled = false;
      }
    });
</script>
