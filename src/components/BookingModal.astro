<dialog class="booking-dialog" aria-label="Wybór terminu konsultacji">
  <div class="booking-shell">
    <div class="booking-content">
      <section class="booking-calendar" aria-label="Wybór terminu konsultacji">
        <button
          class="booking-close"
          type="button"
          data-booking-close
          aria-label="Zamknij kalendarz"
          title="Zamknij kalendarz"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
        <div class="calendar-pane">
          <div class="month-heading">
            <h2 data-month-label aria-live="polite"></h2>
            <div class="month-controls">
              <button type="button" data-month="-1" aria-label="Poprzedni miesiąc">←</button>
              <button type="button" data-month="1" aria-label="Następny miesiąc">→</button>
            </div>
          </div>
          <div class="calendar-grid" aria-hidden="true">
            <span>Pn</span><span>Wt</span><span>Śr</span><span>Cz</span><span>Pt</span><span>Sb</span
            ><span>Nd</span>
          </div>
          <div class="calendar-grid calendar-days" data-calendar-days></div>
          <p class="calendar-help">Dostępne dni: poniedziałek–piątek.</p>
        </div>

        <aside class="booking-details">
          <div class="booking-summary-card">
            <p class="eyebrow">Konsultacja online</p>
            <h2>Spokojna rozmowa o Twoich potrzebach.</h2>
            <p>Spotkanie trwa 60 minut. Wybierz termin od poniedziałku do piątku, w godzinach 9:00–16:00.</p>
          </div>
          <section class="time-section" data-time-section hidden aria-labelledby="time-title">
            <h3 id="time-title">Wybierz godzinę</h3>
            <p class="selected-day" data-selected-day></p>
            <div class="time-options" data-time-options></div>
          </section>

          <form class="booking-form" data-booking-form hidden>
            <h3>Twoje dane</h3>
            <p class="booking-summary" data-booking-summary></p>
            <label class="field">
              Imię
              <input name="name" required maxlength="80" autocomplete="given-name" />
            </label>
            <label class="field">
              Adres e-mail
              <input
                name="email"
                type="email"
                required
                maxlength="254"
                autocomplete="email"
                placeholder="twoj@email.pl"
              />
            </label>
            <button class="btn" type="submit">
              Pokaż podsumowanie <span aria-hidden="true">↗</span>
            </button>
          </form>

          <div class="booking-result" data-booking-result role="status" tabindex="-1" hidden>
            <h3>Podgląd gotowy</h3>
            <p>
              To tylko wersja demonstracyjna — zgłoszenie nie zostało wysłane, a termin nie jest
              zarezerwowany.
            </p>
            <button class="btn btn-outline" type="button" data-booking-reset>
              Wybierz inny termin
            </button>
          </div>
          <div class="booking-demo-note" role="note">
            Kalendarz demonstracyjny. Formularz nie wysyła danych i nie rezerwuje terminu.
          </div>
        </aside>
      </section>
    </div>
  </div>
</dialog>

<style is:global>
  .booking-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: auto;
    border: 0;
    background: #f4f1ed;
    color: #f4f1ed;
  }
  .booking-dialog::backdrop {
    background: #171717;
  }
  .booking-shell {
    width: 100%;
    min-height: 100%;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 72px);
  }
  .month-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid #c8c0b8;
    border-radius: 999px;
    background: transparent;
    color: inherit;
  }
  .booking-content {
    padding-block: clamp(28px, 5vh, 52px);
  }
  .booking-demo-note {
    max-width: 420px;
    margin-top: 24px;
    padding: 14px 16px;
    border-left: 3px solid #c98172;
    background: #303030;
    color: #e8e2dc;
    font-size: 12px;
  }
  .booking-calendar {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
    align-items: start;
    gap: clamp(20px, 3vw, 42px);
    width: 100%;
    padding: 48px clamp(16px, 2.5vw, 30px) clamp(16px, 2.5vw, 30px);
    border: 1px solid #3e3e3e;
    border-radius: 10px;
    background: #242424;
  }
  .booking-close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid #555;
    border-radius: 50%;
    background: #242424;
    color: #f4f1ed;
  }
  .booking-close:hover {
    border-color: #c98172;
    background: #38302e;
  }
  .booking-close svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }
  .calendar-pane {
    min-width: 0;
  }
  .booking-details {
    min-width: 0;
  }
  .booking-summary-card {
    padding-bottom: 18px;
    border-bottom: 1px solid #414141;
  }
  .booking-summary-card .eyebrow {
    margin-bottom: 12px;
  }
  .booking-summary-card h2 {
    max-width: 460px;
    font-size: clamp(2rem, 3.2vw, 3rem);
  }
  .booking-summary-card > p:last-child {
    margin-top: 14px;
    color: #c4c0bc;
    font-size: 12px;
  }
  .month-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .month-heading h2 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: capitalize;
  }
  .month-controls {
    display: flex;
    gap: 8px;
  }
  .month-controls button {
    width: 29px;
    height: 29px;
    font-size: 14px;
  }
  .month-controls button:hover {
    border-color: #c98172;
    background: #38302e;
  }
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 3px;
    text-align: center;
  }
  .calendar-grid > span {
    padding-bottom: 5px;
    color: #c4c0bc;
    font-size: 10px;
    font-weight: 600;
  }
  .calendar-days {
    gap: 3px;
  }
  .calendar-days > * {
    aspect-ratio: 1;
    min-width: 0;
  }
  .calendar-day {
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: #f4f1ed;
    font-size: 11px;
  }
  .calendar-day:not(:disabled):hover {
    border-color: #c98172;
  }
  .calendar-day:disabled {
    color: #747474;
    cursor: not-allowed;
  }
  .calendar-day[aria-pressed='true'] {
    border-color: #c98172;
    background: #c98172;
    color: #171717;
    font-weight: 700;
  }
  .calendar-day.today {
    border-color: #c98172;
  }
  .calendar-help,
  .selected-day {
    margin-top: 8px;
    color: #bcb8b4;
    font-size: 10px;
  }
  .time-section,
  .booking-form,
  .booking-result {
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid #414141;
  }
  .time-section h3,
  .booking-form h3,
  .booking-result h3 {
    font-size: 22px;
  }
  .time-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin-top: 12px;
  }
  .time-option {
    padding: 6px 3px;
    border: 1px solid #555;
    border-radius: 6px;
    background: #303030;
    color: #f4f1ed;
    font-size: 10px;
  }
  .time-option[aria-pressed='true'] {
    border-color: #c98172;
    background: #c98172;
    color: #171717;
    font-weight: 600;
  }
  .booking-form .booking-summary {
    margin-block: 10px 20px;
    color: #c4c0bc;
    font-size: 12px;
  }
  .booking-form .field {
    margin-bottom: 14px;
  }
  .booking-result p {
    margin-block: 12px 20px;
    color: #c4c0bc;
    font-size: 13px;
  }
  .booking-calendar .field {
    color: #e8e2dc;
  }
  .booking-calendar input:not([type='checkbox']) {
    border-color: #555;
    background: #303030;
    color: #f4f1ed;
  }
  .booking-calendar input::placeholder {
    color: #aaa39d;
  }
  .booking-calendar .btn-outline {
    border-color: #777;
    color: #f4f1ed;
  }
  .booking-calendar .btn-outline:hover {
    background: #38302e;
  }
  @media (max-width: 820px) {
    .booking-content {
      padding-block: 40px;
    }
    .booking-calendar {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.85fr);
      gap: 24px;
      padding: 18px;
    }
    .booking-demo-note {
      margin-top: 20px;
    }
  }
  @media (max-width: 520px) {
    .booking-shell {
      padding-inline: 16px;
    }
    .booking-content {
      padding-block: 32px;
    }
    .booking-calendar {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 14px 9px;
    }
    .calendar-grid,
    .calendar-days {
      gap: 3px;
    }
    .calendar-day {
      font-size: 12px;
    }
    .time-options {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.booking-dialog');
  const dayGrid = dialog?.querySelector<HTMLElement>('[data-calendar-days]');
  const monthLabel = dialog?.querySelector<HTMLElement>('[data-month-label]');
  const timeSection = dialog?.querySelector<HTMLElement>('[data-time-section]');
  const timeOptions = dialog?.querySelector<HTMLElement>('[data-time-options]');
  const selectedDay = dialog?.querySelector<HTMLElement>('[data-selected-day]');
  const bookingForm = dialog?.querySelector<HTMLFormElement>('[data-booking-form]');
  const bookingSummary = dialog?.querySelector<HTMLElement>('[data-booking-summary]');
  const bookingResult = dialog?.querySelector<HTMLElement>('[data-booking-result]');
  let monthOffset = 0;
  let chosenDate: Date | null = null;
  let chosenTime: string | null = null;
  let lastTrigger: HTMLElement | null = null;

  const localDateKey = (date: Date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  };
  const dateFromKey = (key: string) => {
    const [year, month, day] = key.split('-').map(Number);
    return new Date(year!, month! - 1, day!);
  };
  const formatDate = (date: Date) =>
    new Intl.DateTimeFormat('pl-PL', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(date);

  function renderCalendar() {
    if (!dayGrid || !monthLabel) return;
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const todayKey = localDateKey(today);
    const month = new Date(today.getFullYear(), today.getMonth() + monthOffset, 1);
    const lastDate = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
    const leadingDays = (month.getDay() + 6) % 7;
    const maximumDate = new Date(today);
    maximumDate.setDate(maximumDate.getDate() + 90);

    monthLabel.textContent = new Intl.DateTimeFormat('pl-PL', {
      month: 'long',
      year: 'numeric',
    }).format(month);
    const previous = dialog?.querySelector<HTMLButtonElement>('[data-month="-1"]');
    const next = dialog?.querySelector<HTMLButtonElement>('[data-month="1"]');
    if (previous) previous.disabled = monthOffset <= 0;
    if (next) next.disabled = monthOffset >= 3;

    const cells = Array.from({ length: leadingDays }, () => '<span aria-hidden="true"></span>');
    for (let day = 1; day <= lastDate; day++) {
      const date = new Date(month.getFullYear(), month.getMonth(), day);
      const key = localDateKey(date);
      const dayNumber = date.getDay();
      const isWeekday = dayNumber >= 1 && dayNumber <= 5;
      const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      const hasFutureSlot =
        key !== todayKey ||
        Array.from({ length: 7 }, (_, index) => `${String(index + 9).padStart(2, '0')}:00`).some(
          (time) => time > currentTime,
        );
      const enabled = isWeekday && date >= today && date <= maximumDate && hasFutureSlot;
      const isToday = key === todayKey;
      const isSelected = chosenDate ? key === localDateKey(chosenDate) : false;
      cells.push(
        `<button class="calendar-day${isToday ? ' today' : ''}" type="button" data-date="${key}" aria-label="${formatDate(date)}" aria-pressed="${isSelected}" ${enabled ? '' : 'disabled'}>${day}</button>`,
      );
    }
    dayGrid.innerHTML = cells.join('');
  }

  function renderTimes() {
    if (!chosenDate || !timeSection || !timeOptions || !selectedDay) return;
    selectedDay.textContent = formatDate(chosenDate);
    timeSection.hidden = false;
    const now = new Date();
    const todayKey = localDateKey(now);
    const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    timeOptions.innerHTML = Array.from({ length: 7 }, (_, index) => {
      const time = `${String(index + 9).padStart(2, '0')}:00`;
      const isSelected = chosenTime === time;
      const isAvailable = localDateKey(chosenDate!) !== todayKey || time > currentTime;
      return `<button class="time-option" type="button" data-time="${time}" aria-pressed="${isSelected}" ${isAvailable ? '' : 'disabled'}>${time}</button>`;
    }).join('');
  }

  function resetBooking() {
    monthOffset = 0;
    chosenDate = null;
    chosenTime = null;
    bookingForm?.reset();
    if (timeSection) timeSection.hidden = true;
    if (bookingForm) bookingForm.hidden = true;
    if (bookingResult) bookingResult.hidden = true;
    renderCalendar();
  }

  document.querySelectorAll<HTMLElement>('[data-booking-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      if (!dialog || dialog.open) return;
      lastTrigger = trigger;
      resetBooking();
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-booking-close]')?.focus();
    });
  });

  dialog?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-booking-close]')) {
      dialog.close();
      return;
    }
    const monthButton = event.target.closest<HTMLButtonElement>('[data-month]');
    if (monthButton && !monthButton.disabled) {
      monthOffset += Number(monthButton.dataset.month);
      chosenDate = null;
      chosenTime = null;
      if (timeSection) timeSection.hidden = true;
      if (bookingForm) bookingForm.hidden = true;
      renderCalendar();
      return;
    }
    const dayButton = event.target.closest<HTMLButtonElement>('[data-date]');
    if (dayButton && !dayButton.disabled) {
      chosenDate = dateFromKey(dayButton.dataset.date!);
      chosenTime = null;
      if (bookingForm) bookingForm.hidden = true;
      if (bookingResult) bookingResult.hidden = true;
      renderCalendar();
      renderTimes();
      return;
    }
    const timeButton = event.target.closest<HTMLButtonElement>('[data-time]');
    if (timeButton) {
      chosenTime = timeButton.dataset.time!;
      if (timeOptions) {
        timeOptions.querySelectorAll<HTMLButtonElement>('[data-time]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button === timeButton));
        });
      }
      if (bookingSummary && chosenDate) {
        bookingSummary.textContent = `${formatDate(chosenDate)} o ${chosenTime} · konsultacja online, 60 minut`;
      }
      if (bookingForm) bookingForm.hidden = false;
      if (bookingResult) bookingResult.hidden = true;
      return;
    }
    const resetButton = event.target.closest('[data-booking-reset]');
    if (resetButton) resetBooking();
  });

  bookingForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!bookingForm.reportValidity() || !chosenDate || !chosenTime) return;
    bookingForm.hidden = true;
    if (bookingResult) {
      bookingResult.hidden = false;
      bookingResult.focus();
    }
  });

  dialog?.addEventListener('close', () => {
    resetBooking();
    lastTrigger?.focus();
    lastTrigger = null;
  });
</script>
