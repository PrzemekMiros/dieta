---
import { money, type Product } from '../lib/types';
interface Props {
  product: Product;
}
const { product: p } = Astro.props;
---

<article class="product-card" data-reveal>
  <a
    href={`/produkt/${p.slug}`}
    class:list={['product-image', { ebook: p.productType === 'digital' }]}
    aria-label={`Zobacz ${p.name}`}
  >
    {p.productType === 'digital' && p.demo ? (
      <div class="book">
        <span>TORTOWE CIOCHO</span>
        <h3>{p.name}</h3>
        <img src={p.image} alt="" width="400" height="400" loading="lazy" />
        <small>PRZEPISY · WSKAZÓWKI · INSPIRACJE</small>
      </div>
    ) : (
      <img
        src={p.image || '/images/cake-editorial.webp'}
        width="600"
        height="660"
        alt={p.demo ? 'Ilustracja koncepcyjna — produkt demonstracyjny' : p.name}
        loading="lazy"
      />
    )}
    <span class="product-tag">
      {p.productType === 'digital' ? 'Ebook · PDF' : 'Pieczywo'}
    </span>
  </a>
  <div class="flex justify-between gap-4 mt-6">
    <h3>
      <a href={`/produkt/${p.slug}`}>{p.name}</a>
    </h3>
    <span class="price">{money(p.price)}</span>
  </div>
  <p class="muted text-sm mt-3 mb-5">{p.shortDescription}</p>
  <button type="button" class="text-link" data-add={p._id} disabled={!p.active || p.stock === 0}>
    {p.stock === 0 ? 'Niedostępny' : 'Dodaj do koszyka'} <span aria-hidden="true">+</span>
  </button>
</article>
<style>
  .product-image {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4/4.5;
    background: #e8e1da;
    border-radius: 190px 190px 8px 8px;
    overflow: hidden;
  }
  .product-image > img {
    height: 100%;
    width: 100%;
    transition: transform 0.7s;
  }
  .product-image:hover > img {
    transform: scale(1.035);
  }
  .product-tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
    padding: 5px 12px;
    border-radius: 30px;
    background: #f7f6f4e8;
    font-size: 10px;
  }
  .product-card h3 {
    font-size: 26px;
  }
  .price {
    white-space: nowrap;
    font-size: 13px;
    padding-top: 6px;
  }
  .book {
    width: 65%;
    height: 78%;
    padding: 22px 18px 12px;
    display: flex;
    flex-direction: column;
    background: #f5eee5;
    box-shadow: 10px 15px 25px #382b2825;
    border-left: 6px solid #d5c6b7;
    transform: rotate(-7deg);
    text-align: center;
  }
  .book > span {
    font-size: 8px;
    letter-spacing: 0.1em;
  }
  .book h3 {
    font-size: 27px;
    margin: 18px 0;
  }
  .book img {
    min-height: 0;
    flex: 1;
    width: 100%;
    border-radius: 100px 100px 0 0;
  }
  .book small {
    font-size: 6px;
    margin-top: 10px;
  }
  .product-card:nth-child(2n) .ebook {
    background: #e0d4ce;
  }
  .product-card:nth-child(2n) .book {
    transform: rotate(5deg);
  }
</style>
