---
import Layout from '../../layouts/Layout.astro';
import PortableText from '../../components/PortableText.astro';
import { posts } from '../../lib/catalog';
const articles = await posts();
const p = articles.find((p) => p.slug === Astro.params.slug);
if (!p) return Astro.redirect('/404');
const latestPosts = articles
  .filter((article) => article.slug !== p.slug)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 3);
---

<Layout title={p.seoTitle || p.title} description={p.seoDescription || p.excerpt} image={p.image}>
  <div class="container section blog-layout">
    <article class="blog-article">
      <a href="/blog" class="text-link mb-6">
        ← Blog zdrowotny
      </a>
      <h1 class="max-w-4xl">{p.title}</h1>
      <p class="eyebrow !mt-6 !mb-0 text-md">
        {new Date(p.publishedAt).toLocaleDateString('pl-PL')}
      </p>
      <p class="intro muted">{p.excerpt}</p>
      {p.image && (
        <img
          src={p.image}
          width="1200"
          height="650"
          alt={p.imageAlt || p.title}
          class="max-h-[500px] w-full rounded-xl mt-6 mb-12"
        />
      )}
      <PortableText blocks={p.content} />
    </article>
    <aside class="blog-sidebar" aria-labelledby="sidebar-title">
      <h2 id="sidebar-title">Czytaj także</h2>
      {latestPosts.length > 0 && (
        <ul class="sidebar-posts">
          {latestPosts.map((article) => (
            <li>
              <a href={`/blog/${article.slug}`} class="sidebar-post">
                <img
                  src={article.image || '/images/baking-editorial.webp'}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                />
                <div>
                  <h3>{article.title}</h3>
                  <time datetime={article.publishedAt} class="muted">
                    {new Date(article.publishedAt).toLocaleDateString('pl-PL')}
                  </time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
      <a href="/blog" class="text-link">
        Wszystkie wpisy <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .blog-article {
    min-width: 0;
  }
  .blog-sidebar {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface-raised);
  }
  .blog-sidebar h2 {
    font-size: 32px;
    margin: 0 0 24px;
  }
  .sidebar-posts {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .sidebar-posts li + li {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .sidebar-post {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  .sidebar-post img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
  }
  .sidebar-post h3 {
    font-size: 18px;
    line-height: 1.25;
    margin: 0 0 8px;
  }
  .sidebar-post:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sidebar-post time {
    font-size: 12px;
  }
  @media (max-width: 900px) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
