---
import Layout from '../../layouts/Layout.astro';
import PortableText from '../../components/PortableText.astro';
import { posts } from '../../lib/catalog';
const articles = await posts();
const p = articles.find((p) => p.slug === Astro.params.slug);
if (!p) return Astro.redirect('/404');
const chronologicalPosts = [...articles].sort((a, b) =>
  new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime() || a.slug.localeCompare(b.slug),
);
const currentIndex = chronologicalPosts.findIndex((article) => article.slug === p.slug);
const previousPost = chronologicalPosts[currentIndex - 1];
const nextPost = chronologicalPosts[currentIndex + 1];
const latestPosts = articles
  .filter((article) => article.slug !== p.slug)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 3);
const articleText = [p.excerpt, ...p.content.map((block) =>
  block.children?.map((child) => child.text).join('') || '',
)].join(' ');
const readingMinutes = Math.max(1, Math.ceil(articleText.trim().split(/\s+/).length / 200));
const shareUrl = Astro.url.href;
---

<Layout title={p.seoTitle || p.title} description={p.seoDescription || p.excerpt} image={p.image}>
  <article class="container section blog-article">
    <header class="article-grid article-header">
      <a href="/blog" class="back-link"><span aria-hidden="true">←</span> Blog</a>
      <div class="article-heading">
        <h1>{p.title}</h1>
        <p class="article-excerpt">{p.excerpt}</p>
      </div>
      <dl class="article-meta side-column">
        <div>
          <dt>Data publikacji</dt>
          <dd><time datetime={p.publishedAt}>{new Date(p.publishedAt).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}</time></dd>
        </div>
        <div>
          <dt>W dziale</dt>
          <dd><a href="/blog">Blog zdrowotny</a></dd>
        </div>
        <div>
          <dt>Czas czytania</dt>
          <dd>{readingMinutes} min</dd>
        </div>
      </dl>
    </header>
    {p.image && (
      <img
        src={p.image}
        width="1200"
        height="610"
        alt={p.imageAlt || p.title}
        class="article-cover"
        fetchpriority="high"
      />
    )}
    <div class="article-grid article-body">
      <div class="article-content">
        <PortableText blocks={p.content} />
      </div>
      <aside class="article-sidebar side-column" aria-label="O blogu i powiązane wpisy">
        <div class="about-blog">
          <p class="sidebar-label">O blogu</p>
          <p class="sidebar-description">O jedzeniu, zdrowych nawykach i codzienności. Spokojnie, praktycznie i bez presji.</p>
        </div>
        <div class="share">
          <p class="sidebar-label">Udostępnij</p>
          <div class="share-links">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Udostępnij na Facebooku">f</a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Udostępnij na LinkedIn">in</a>
            <a href={`mailto:?subject=${encodeURIComponent(p.title)}&body=${encodeURIComponent(shareUrl)}`} aria-label="Udostępnij przez e-mail">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
            </a>
          </div>
        </div>
        {latestPosts.length > 0 && (
          <nav class="related-posts" aria-labelledby="related-title">
            <h2 id="related-title" class="sidebar-label">Czytaj także</h2>
            <ul>
              {latestPosts.map((article) => (
                <li><a href={`/blog/${article.slug}`}>{article.title}<span aria-hidden="true"> ↗</span></a></li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
    </div>
    {(previousPost || nextPost) && (
      <nav class="article-footer" aria-label="Nawigacja między wpisami">
        {previousPost && (
          <a href={`/blog/${previousPost.slug}`} class="post-navigation-link" rel="prev">
            <span class="post-navigation-label">← Poprzedni wpis</span>
            <span class="post-navigation-title">{previousPost.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={`/blog/${nextPost.slug}`} class="post-navigation-link next-post" rel="next">
            <span class="post-navigation-label">Kolejny wpis →</span>
            <span class="post-navigation-title">{nextPost.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>

<style>
  .blog-article { padding-top: clamp(32px, 5vw, 72px); }
  .article-grid {
    display: grid;
    grid-template-columns: minmax(80px, 0.8fr) minmax(0, 3fr) minmax(180px, 1.1fr);
    column-gap: clamp(24px, 3vw, 48px);
  }
  .article-header { align-items: start; margin-bottom: 40px; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    border: 1px solid var(--color-border-strong);
    border-radius: 3px;
    padding: 5px 10px;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .back-link:hover { background: var(--color-beige); }
  .article-heading h1 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 3.8vw, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.045em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .article-excerpt { margin-top: 22px; font-size: 16px; line-height: 1.65; color: var(--color-muted); }
  .side-column { border-left: 1px solid var(--color-border-strong); padding-left: clamp(20px, 2vw, 32px); }
  .article-sidebar { position: sticky; top: 60px; align-self: start; }
  .article-meta { margin: 0; align-self: stretch; }
  .article-meta > div + div { margin-top: 24px; }
  .article-meta dt, .sidebar-label {
    margin: 0 0 8px;
    font-family: var(--font-sans);
    color: var(--color-muted);
    font-size: 9px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .article-meta dd { margin: 0; font-size: 11px; line-height: 1.6; }
  .article-cover { width: 100%; height: auto; aspect-ratio: 1.97; object-fit: cover; border-radius: 6px; margin-bottom: 40px; }
  .article-content { grid-column: 2; min-width: 0; }
  .article-content :global(.prose) { max-width: none; font-size: 14px; line-height: 1.85; overflow-wrap: anywhere; }
  .article-content :global(.prose > :first-child) { margin-top: 0; }
  .article-content :global(.prose h2), .article-content :global(.prose h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .article-content :global(.prose h2) { font-size: 26px; margin-top: 36px; }
  .article-content :global(.prose h3) { font-size: 20px; margin-top: 28px; }
  .article-content :global(.prose p) { margin-block: 18px; }
  .editor-name { font-size: 14px; font-weight: 500; }
  .sidebar-description { margin-top: 10px; font-size: 11px; line-height: 1.85; color: var(--color-muted); }
  .share { margin-top: 28px; }
  .share-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .share-links a { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--color-border-strong); border-radius: 50%; font-size: 13px; }
  .share-links a:hover { background: var(--color-beige); }
  .related-posts { margin-top: 36px; }
  .related-posts ul { list-style: none; padding: 0; margin: 0; }
  .related-posts li { padding-block: 14px; border-bottom: 1px solid var(--color-border); font-size: 12px; line-height: 1.65; }
  .related-posts a:hover, .editor-name:hover, .article-meta a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .article-footer { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; border-top: 1px solid var(--color-border-strong); margin-top: 42px; padding-top: 24px; }
  .post-navigation-link { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .post-navigation-label { font-size: 12px; color: var(--color-muted); }
  .post-navigation-title { font-family: var(--font-serif); font-size: 24px; line-height: 1.25; overflow-wrap: anywhere; }
  .post-navigation-link:hover .post-navigation-title { text-decoration: underline; text-underline-offset: 4px; }
  .next-post { grid-column: 2; text-align: right; align-items: flex-end; }
  @media (max-width: 1000px) {
    .article-grid { grid-template-columns: minmax(0, 1fr) 200px; }
    .back-link { grid-column: 1 / -1; margin-bottom: 24px; }
    .article-content { grid-column: 1; }
  }
  @media (max-width: 640px) {
    .article-grid { grid-template-columns: minmax(0, 1fr); }
    .article-header { margin-bottom: 28px; }
    .article-heading h1 { font-size: clamp(32px, 8vw, 44px); }
    .article-excerpt { font-size: 15px; margin-top: 18px; }
    .article-meta { display: flex; flex-wrap: wrap; gap: 20px 28px; margin-top: 28px; border-left: 0; border-top: 1px solid var(--color-border); padding: 20px 0 0; }
    .article-meta > div + div { margin-top: 0; }
    .article-cover { aspect-ratio: 4 / 3; margin-bottom: 28px; }
    .article-sidebar { margin-top: 28px; border-left: 0; border-top: 1px solid var(--color-border); padding: 24px 0 0; }
    .article-content :global(.prose) { font-size: 15px; }
  }
</style>
