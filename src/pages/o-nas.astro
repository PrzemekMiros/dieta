---
import Layout from '../layouts/Layout.astro';
import HomeSection from '../components/HomeSection.astro';
import PortableText from '../components/PortableText.astro';
import { contentPage } from '../lib/catalog';
const page = await contentPage('o-nas');
---

<Layout title="O mnie">
  <section class="container section">
    <p class="eyebrow">Twoja Dietetyczka</p>
    <h1>
      Zdrowie zaczyna się
      <br />
      od prostych wyborów.
    </h1>
    {page ? (
      <PortableText blocks={page.content} />
    ) : (
      <p class="intro muted">
        Łączę wiedzę akademicką z życiowym podejściem. Wspieram dorosłych, dzieci i rodziców oraz
        kobiety w ciąży, pomagając budować nawyki dopasowane do codziennego życia.
      </p>
    )}
  </section>
  <HomeSection section={{ key: 'about' }} products={[]} home={{}} />
  <HomeSection section={{ key: 'philosophy' }} products={[]} home={{}} />
  <HomeSection section={{ key: 'categories' }} products={[]} home={{}} />
</Layout>
