---
import Layout from '../layouts/Layout.astro';
import { settings } from '../lib/catalog';
const s = await settings();
const contactEmail = s.email || 'dietetykadlasmyka@gmail.com';
---

<Layout title="Kontakt">
  <section class="section container split">
    <div>
      <p class="eyebrow">Porozmawiajmy</p>
      <h1>
        Zadbaj o swoje
        <br />
        zdrowie już dziś.
      </h1>
      <p class="intro muted">
        Chcesz poprawić odżywianie, lepiej się czuć lub zacząć zdrowe nawyki bez presji? Napisz do
        mnie — chętnie pomogę dobrać odpowiednie wsparcie.
      </p>
      <button class="btn mt-8" type="button" data-booking-open>
        Umów konsultację <span aria-hidden="true">↗</span>
      </button>
    </div>
    <div class="card">
      <h2 class="!text-3xl">Napisz albo zadzwoń</h2>
      <div class="contact-row mt-7">
        <span class="contact-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="m4 7 8 6 8-6" />
          </svg>
        </span>
        <div class="contact-details">
          <p class="text-xs muted">E-mail</p>
          <a class="contact-link" href={`mailto:${contactEmail}`}>
            {contactEmail} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      {s.phone && (
        <div class="contact-row mt-6">
          <span class="contact-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 3H5a2 2 0 0 0-2 2c0 8.84 7.16 16 16 16a2 2 0 0 0 2-2v-3l-5-2-2 2a13 13 0 0 1-6-6l2-2-2-5Z" />
            </svg>
          </span>
          <div class="contact-details">
            <p class="text-xs muted">Telefon</p>
            <a class="contact-link" href={`tel:${s.phone.replace(/[^+\d]/g, '')}`}>
              {s.phone}
            </a>
          </div>
        </div>
      )}
      <div class="contact-row mt-6">
        <span class="contact-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
        </span>
        <div class="contact-details">
          <p class="text-xs muted">Godziny pracy</p>
          <p>
            <time datetime="08:00">8:00</time>–<time datetime="16:00">16:00</time>
          </p>
        </div>
      </div>
      {s.companyName && <p class="mt-8">{s.companyName}</p>}
      {s.address && <p>{s.address}</p>}
      {s.nip && <p>NIP: {s.nip}</p>}
      <p class="mt-6 text-sm">
        W sprawie płatności, reklamacji lub odstąpienia od umowy napisz na powyższy adres e-mail.
        Numer zamówienia pomoże nam szybciej odnaleźć Twój zakup.
      </p>
      <a class="text-link mt-4" href="/dostawa-i-zwroty">
        Dostawa i zwroty →
      </a>
    </div>
  </section>
</Layout>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .contact-icon {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-beige);
    color: var(--color-action);
  }
  .contact-icon svg {
    width: 22px;
    height: 22px;
  }
  .contact-details {
    min-width: 0;
  }
  .contact-link {
    display: inline-block;
    padding-block: 4px;
    overflow-wrap: anywhere;
  }
  .contact-link:hover {
    color: var(--color-action);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
