---
import Layout from '../../layouts/Layout.astro';
import { product } from '../../lib/catalog';
import { money } from '../../lib/types';
import { siteUrl } from '../../lib/server/env';
const p = await product(Astro.params.slug!);
if (!p) return Astro.redirect('/404');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.shortDescription,
  image: p.image,
  sku: p.sku,
  offers: {
    '@type': 'Offer',
    price: (p.price / 100).toFixed(2),
    priceCurrency: 'PLN',
    availability: p.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    url: siteUrl() + '/produkt/' + p.slug,
  },
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sklep', item: siteUrl() + '/sklep' },
    { '@type': 'ListItem', position: 2, name: p.name, item: Astro.url.href },
  ],
};
---

<Layout
  title={p.seoTitle || p.name}
  description={p.seoDescription || p.shortDescription}
  image={p.image}
>
  <section class="container section">
    <div class="split items-start">
      <img
        class="rounded-t-full w-full max-h-[680px]"
        src={p.image}
        alt={p.demo ? 'Ilustracja koncepcyjna' : p.name}
        width="700"
        height="850"
      />
      <div>
        <nav class="product-breadcrumbs text-xs muted" aria-label="Okruszki">
          <a href="/sklep">Sklep</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{p.name}</span>
        </nav>
        <h1 class="!text-5xl">{p.name}</h1>
        <p class="eyebrow product-category">
          {p.category || (p.productType === 'digital' ? 'Ebook · PDF' : 'Pieczywo')}
        </p>
        <p class="intro muted">{p.shortDescription}</p>
        <p class="text-2xl mt-8">
          {money(p.price)} <small class="text-xs muted">brutto</small>
        </p>
        <p class="text-sm muted mt-3">
          {p.productType === 'digital'
            ? 'Bez dostawy fizycznej. Link po potwierdzeniu płatności.'
            : 'Koszt dostawy obliczymy w koszyku.'}
        </p>
        <button class="btn mt-8" data-add={p._id} disabled={p.stock === 0}>
          Dodaj do koszyka <span>+</span>
        </button>
        {p.demo && (
          <p class="notice">Produkt demonstracyjny. Nie można go kupić w prawdziwym checkout.</p>
        )}
        <div class="prose mt-10">
          <h2>Warto wiedzieć</h2>
          <p>{p.description}</p>
        </div>
        <p class="text-xs muted mt-8">SKU: {p.sku}</p>
      </div>
    </div>
  </section>
  {!p.demo && (
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(crumbs).replace(/</g, '\\u003c')} />
</Layout>
<style>
  .product-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 20px;
  }
  .product-breadcrumbs a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .product-breadcrumbs [aria-current='page'] {
    overflow-wrap: anywhere;
  }
  .product-category {
    margin-top: 12px;
    margin-bottom: 0;
  }
</style>
