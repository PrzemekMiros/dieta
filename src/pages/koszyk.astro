---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Twój koszyk" noindex>
  <section class="container section">
    <p class="eyebrow">Zakupy · krok 1 z 2</p>
    <h1>Twój koszyk.</h1>
    <p class="page-intro muted">
      Sprawdź produkty i ilości. Ceny oraz dostępność potwierdzimy przed płatnością.
    </p>
    <nav class="checkout-progress" aria-label="Etapy zakupu">
      <ol>
        <li aria-current="step">
          <span>1</span> Koszyk
        </li>
        <li>
          <span>2</span> Dane i płatność
        </li>
      </ol>
    </nav>
    <div class="cart-layout">
      <div data-cart-lines aria-live="polite" aria-busy="true">
        <p>Wczytywanie koszyka…</p>
      </div>
      <aside class="card cart-summary" data-cart-summary hidden>
        <p class="eyebrow">Podsumowanie</p>
        <h2 class="!text-3xl">Twój koszyk</h2>
        <p class="cart-item-count muted" data-cart-items></p>
        <div class="flex justify-between mt-6 gap-4">
          <span>Produkty</span>
          <span data-subtotal></span>
        </div>
        <div class="flex justify-between mt-4 gap-4">
          <span>Dostawa</span>
          <span data-shipping></span>
        </div>
        <div class="flex justify-between border-t border-border mt-6 pt-6 gap-4">
          <strong>Razem</strong>
          <strong data-total></strong>
        </div>
        <a href="/zamowienie" class="btn w-full mt-8">
          Przejdź do danych i płatności <span aria-hidden="true">→</span>
        </a>
        <p class="cart-summary-note muted">
          Bez zakładania konta. Koszt dostawy potwierdzisz w następnym kroku.
        </p>
        <p class="cart-safe-note">
          <span aria-hidden="true">✓</span> Bezpieczna płatność przez Przelewy24
        </p>
      </aside>
    </div>
    <a href="/sklep" class="text-link cart-continue">
      ← Wróć do produktów
    </a>
    <noscript>
      <p class="notice">Koszyk wymaga JavaScript. Włącz go w przeglądarce.</p>
    </noscript>
  </section>
</Layout>
<style is:global>
  .page-intro {
    max-width: 620px;
    margin-top: 20px;
  }
  .checkout-progress {
    max-width: 560px;
    margin-block: 36px 12px;
  }
  .checkout-progress ol {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 0;
    list-style: none;
  }
  .checkout-progress li {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 12px;
    color: var(--color-text-step);
    font-size: 13px;
  }
  .checkout-progress li[aria-current='step'] {
    border-color: var(--color-action);
    color: var(--color-ink);
    font-weight: 600;
  }
  .checkout-progress li span {
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
  }
  .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .cart-layout > [data-cart-lines] {
    min-width: 0;
  }
  .cart-summary {
    position: sticky;
    top: 24px;
  }
  .cart-item-count {
    margin-top: 8px;
    font-size: 12px;
  }
  .cart-summary-note {
    margin-top: 14px;
    font-size: 12px;
  }
  .cart-safe-note {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-divider);
    font-size: 11px;
  }
  .cart-safe-note span {
    margin-right: 5px;
    color: var(--color-success);
  }
  .cart-continue {
    margin-top: 36px;
  }
  .cart-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto auto;
    gap: 22px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .cart-row img {
    border-radius: 8px;
    width: 88px;
    height: 96px;
  }
  .cart-quantity-control {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cart-quantity-label {
    color: var(--color-text-cart);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cart-quantity-stepper {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-raised);
  }
  .cart-row .cart-quantity-button {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 0;
    border-radius: 7px;
    background: var(--color-transparent);
    color: var(--color-ink);
    font-size: 20px;
    line-height: 1;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .cart-row .cart-quantity-button:hover:not(:disabled) {
    background: var(--color-surface-hover);
    color: var(--color-action);
  }
  .cart-row .cart-quantity-button:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 1px;
  }
  .cart-row .cart-quantity-button:disabled {
    background: var(--color-surface-hover);
    color: var(--color-text-cart);
    cursor: not-allowed;
    opacity: 1;
  }
  .cart-row .cart-quantity-input {
    width: 38px;
    min-height: 34px;
    padding: 4px 0 !important;
    border: 0;
    border-radius: 4px;
    background: var(--color-transparent);
    color: var(--color-ink);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: center;
    transition: box-shadow 160ms ease;
  }
  .cart-row .cart-quantity-input:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-action) 55%, var(--color-transparent));
  }
  .cart-row .cart-quantity-label {
    color: var(--color-text-cart);
    white-space: nowrap;
  }
  .cart-row > div > a {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.1;
  }
  .cart-row > div > p {
    margin-top: 8px;
  }
  .cart-row > div > .cart-line-total {
    margin-top: 5px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 600;
  }
  .cart-row > button {
    color: var(--color-text-summary);
    font-size: 12px;
  }
  .cart-empty {
    max-width: 600px;
    padding: clamp(28px, 5vw, 52px);
    border: 1px solid var(--color-border-summary);
    border-radius: var(--radius);
    background: var(--color-surface-raised);
  }
  .cart-empty h2 {
    font-size: 32px;
  }
  .cart-empty p {
    margin-block: 12px 24px;
    color: var(--color-muted);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .cart-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cart-summary {
      position: static;
    }
  }
  @media (max-width: 500px) {
    .cart-row {
      grid-template-columns: 60px minmax(0, 1fr);
      gap: 12px;
      padding-block: 18px;
    }
    .cart-row img {
      width: 60px;
      height: 75px;
    }
    .cart-row > button {
      grid-column: 2;
      justify-self: start;
    }
    .cart-quantity-control {
      grid-column: 2;
      justify-self: start;
    }
    .cart-row > div > a {
      font-size: 21px;
    }
    .checkout-progress {
      margin-top: 28px;
    }
    .checkout-progress ol {
      gap: 8px;
    }
    .checkout-progress li {
      gap: 7px;
      font-size: 11px;
    }
  }
</style>
