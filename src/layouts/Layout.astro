---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { settings } from '../lib/catalog';
import { isDemo, siteUrl } from '../lib/server/env';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}
const {
  title,
  description = 'Konsultacje dietetyczne, planowanie żywienia i wsparcie w budowaniu zdrowych nawyków. Twoja Dietetyczka.',
  noindex = false,
  image = '/images/cake-editorial.webp',
} = Astro.props;
const config = await settings();
const canonical = new URL(Astro.url.pathname, siteUrl()).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Twoja Dietetyczka',
  url: siteUrl(),
  email: config.email,
  logo: config.logo,
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Twoja Dietetyczka</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteUrl()).href} />
    <meta name="theme-color" content="#f7f6f4" />
    {(noindex || isDemo()) && <meta name="robots" content="noindex,nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(org).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <Header settings={config} />
    {isDemo() && (
      <div class="demo-banner">
        Wersja demonstracyjna · przykładowe produkty · sprzedaż wyłączona
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer settings={config} />
    <div id="cart-toast" class="toast" role="status" aria-live="polite" hidden></div>
    <script>
      import '../scripts/cart';
      import '../scripts/motion';
    </script>
  </body>
</html>
<style>
  .demo-banner {
    text-align: center;
    padding: 5px 12px;
    background: #e5ded7;
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    max-width: calc(100% - 32px);
    padding: 14px 24px;
    background: #2d2f30;
    color: white;
    border-radius: 8px;
    z-index: 100;
    font-size: 13px;
    box-shadow: 0 4px 20px #0002;
  }
</style>
