---
import Layout from './Layout.astro';
interface Props {
  title: string;
}
---

<Layout title={Astro.props.title} noindex>
  <section class="container section">
    <nav
      class="flex flex-wrap justify-between gap-5 border-b border-border pb-5 mb-10"
      aria-label="Panel administratora"
    >
      <div class="flex gap-6">
        <a href="/admin">Przegląd i zamówienia</a>
        <a href="/admin/magazyn">Magazyn</a>
      </div>
      <button type="button" data-logout class="text-link">
        Wyloguj
      </button>
    </nav>
    <slot />
  </section>
</Layout>
<script>
  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    const response = await fetch('/api/admin/logout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: '{}',
    });
    if (response.ok) location.assign('/admin/login');
  });
</script>
