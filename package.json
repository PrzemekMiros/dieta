{
  "name": "dietetyk-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n astro,sync \"npm:dev:astro\" \"npm:dev:sync\"",
    "dev:astro": "astro dev",
    "dev:sync": "wait-on http-get://127.0.0.1:4321 && browser-sync start --config bs-config.cjs",
    "check": "astro check",
    "build": "astro build && node scripts/build-jobs.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "studio": "npm --prefix studio run dev -- --port 3333",
    "studio:build": "npm --prefix studio run build",
    "studio:deploy": "npm --prefix studio run deploy",
    "studio:schema:deploy": "npm --prefix studio run schema:deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "sanity:seed": "tsx scripts/sanity-seed.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/jobs/worker.mjs",
    "payments:reconcile:start": "node --env-file-if-exists=.env dist/jobs/reconcile.mjs",
    "payments:reconcile": "tsx scripts/reconcile.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.11",
    "@astrojs/node": "^11.1.10",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@sanity/astro": "^3.6.0",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "js-yaml@^3": "^3.15.2",
    "smol-toml": "^1.9.1",
    "undici@^7": "^7.30.2",
    "minimatch@>=7 <11": "^11.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
