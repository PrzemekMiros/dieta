# Local preview. Production: APP_ENV=production, DEMO_CATALOG=false.
APP_ENV=development
DEMO_CATALOG=true
SITE_URL=http://localhost:4321
SALES_ENABLED=false
LEGAL_VERSION=1

# Sanity: catalog/content. Studio uses the same project, no write token in browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_READ_TOKEN=
# Only for explicit seed on a development dataset. Never prefix with PUBLIC_.
SANITY_WRITE_TOKEN=

# Local Docker only. Use separate credentials and TLS in production.
DATABASE_URL=postgres://tortowe:local-development-only@localhost:54329/tortowe
SHIPPING_METHODS='[{"id":"standard","name":"Dostawa standardowa","price":1690}]'

# Real sandbox account + public HTTPS callback required to test payments.
P24_ENV=sandbox
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# Only set after owner's explicit approval and successful acceptance tests.
P24_PRODUCTION_APPROVED=false

# Private S3-compatible bucket. Block all public object access.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Local mailpit. Production: real SMTP, TLS, verified sender, SPF/DKIM/DMARC.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tortowe Ciocho <sklep@example.test>"
MAIL_MESSAGE_DOMAIN=example.test
NEWSLETTER_ENABLED=false

# Set temporarily for admin:create; delete after account creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
